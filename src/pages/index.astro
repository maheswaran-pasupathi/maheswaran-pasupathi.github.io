---
import Base from '../layouts/Base.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import StageBadge from '../components/StageBadge.astro';
import { getCollection } from 'astro:content';
import { heroImage, explorationImages } from '../data/siteImages';

const allPosts = (await getCollection('writings', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const posts = allPosts.slice(0, 4);
---
<Base>
  <section class="wrap hero">
    <div>
      <div class="eyebrow">Engineering field notebook + life archive</div>
      <h1>I build, learn, question — and document what stays.</h1>
      <p>I'm Maheswaran, a thermal-fluid and CFD engineer exploring how heat, flow and physics shape engines, batteries, electric vehicles and complete vehicle systems — and how AI can make engineering faster, clearer and more useful. This is where simulations, experiments, books, journeys and unfinished questions live together.</p>
    </div>
    <aside class="card">
      <div class="eyebrow">Currently exploring</div>
      <div class="tags">
        <span>Battery & EV thermal</span><span>Vehicle thermal & flow</span><span>Engine thermal & combustion</span>
        <span>Scientific ML</span><span>Surrogate models</span><span>System simulation</span>
      </div>
      <p><em>Build → Learn → Understand → Document → Revisit.</em></p>
    </aside>
  </section>

  {heroImage && (
    <figure class="hero-figure">
      <img src={heroImage.src} alt={heroImage.alt} />
      {heroImage.credit && (
        <figcaption>
          {heroImage.creditUrl ? <a href={heroImage.creditUrl}>{heroImage.credit}</a> : heroImage.credit}
        </figcaption>
      )}
    </figure>
  )}

  <section id="latest" class="section garden-dashboard">
    <div class="wrap garden-columns">
      <div class="latest-column">
        <div class="eyebrow">Fresh entries</div>
        <h2>Latest from the Garden</h2>
        <p class="stage-legend">🌱 Seedling — a rough note or open question &nbsp;·&nbsp; 🌿 Budding — worked out, could still change &nbsp;·&nbsp; 🌳 Evergreen — revisited and holding up</p>
        <div class="filters">
          <button class="active" data-filter="all">Everything</button>
          <button data-filter="physics">Physics</button>
          <button data-filter="computation">Computation</button>
          <button data-filter="experiments">Experiments</button>
          <button data-filter="journeys">Journeys</button>
          <button data-filter="books">Books & Films</button>
        </div>
        <div class="home-posts">
          {posts.map((post) => (
            <a class="post home-post" data-cat={post.data.category} href={`/writings/${post.id}/`}>
              <div class="visual">
                {post.data.cover && <img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" />}
              </div>
              <div class="content">
                <div class="meta">{post.data.meta}<StageBadge stage={post.data.stage} /></div>
                <h3>{post.data.title}</h3>
                <p>{post.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
        <p><a class="back-link" href="/writings/">All writings →</a></p>
      </div>

      <aside id="map" class="map-column">
        <div class="map-heading">
          <div class="eyebrow">Knowledge Map</div>
          <h2>Ideas should connect like ideas — not like folders.</h2>
          <p>Use the map to move across writing, engineering topics, experiments and the connections between them.</p>
        </div>
        <div class="home-map">
          <KnowledgeGraph posts={allPosts} />
        </div>
      </aside>
    </div>
  </section>

  <section id="explorations" class="section">
    <div class="wrap">
      <div class="eyebrow">Explorations</div>
      <h2>The territories I keep returning to.</h2>
      <div class="grid">
        {[
          { name: 'Engine & Powertrain', items: ['Thermal management', 'Combustion & CHT', 'Air-path & manifolds', 'Alternative fuels', 'System simulation'] },
          { name: 'Battery & EV Thermal', items: ['Cell / pack thermal', 'Cooling architectures', 'Thermal runaway', 'E-drive & electronics', 'Electro-thermal systems'] },
          { name: 'Vehicle & Flow', items: ['Aerodynamics', 'Vehicle thermal management', 'HVAC', 'Cooling airflow', 'Energy & heat flow'] },
          { name: 'AI + Physical Systems', items: ['DOE', 'Surrogates', 'Optimization', 'Scientific ML', 'Automation & agents'] },
        ].map((topic) => {
          const img = explorationImages[topic.name];
          return (
            <div class="topic">
              {img && <img class="topic-img" src={img.src} alt={img.alt} loading="lazy" />}
              <h3>{topic.name}</h3>
              <ul>{topic.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <section id="life" class="section">
    <div class="wrap">
      <div class="eyebrow">Life</div>
      <h2>Books, films, journeys and things worth remembering.</h2>
      <div class="life">
        <div class="card"><h3>Books</h3><p>What stayed with me, not just what I finished.</p></div>
        <div class="card"><h3>Movies & Documentaries</h3><p>Stories, ideas and scenes worth remembering.</p></div>
        <div class="card"><h3>Travel Diary</h3><p>Places, photographs, food, work trips and observations.</p></div>
      </div>
      <p style="margin-top:20px"><a class="back-link" href="/life/">More on Life →</a></p>
    </div>
  </section>
</Base>

<style>
  .garden-dashboard{background:#f1ede4}
  .garden-columns{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(360px,.82fr);gap:34px;align-items:start}
  .latest-column,.map-column{min-width:0}
  .map-column{position:sticky;top:92px}
  .map-heading{margin-bottom:18px}
  .map-heading h2{font-size:30px;margin:7px 0 10px;line-height:1.08}
  .map-heading p{color:#6b6b6b;line-height:1.6;margin:0;max-width:520px}
  .home-map :global(.map){height:620px;border-radius:24px}
  .home-post{grid-template-columns:170px 1fr}
  .home-post .visual{min-height:155px}
  .home-post .content{padding:20px}
  .home-post h3{font-size:22px}
  .home-post p{font-size:14px;line-height:1.55}
  @media(max-width:1050px){
    .garden-columns{grid-template-columns:1fr}
    .map-column{position:static}
    .home-map :global(.map){height:500px}
  }
  @media(max-width:700px){
    .home-post{grid-template-columns:1fr}
    .home-map :global(.map){height:430px}
  }
</style>

<script>
  const buttons = document.querySelectorAll('.filters button');
  const posts = document.querySelectorAll('.post');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.filter;
      posts.forEach((p) => {
        const el = p as HTMLElement;
        el.style.display = cat === 'all' || el.dataset.cat === cat ? 'grid' : 'none';
      });
    });
  });
</script>
