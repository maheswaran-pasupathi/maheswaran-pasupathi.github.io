---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Maheswaran" description="That page doesn't exist.">
  <section class="wrap" style="text-align:center;padding-top:120px;padding-bottom:120px">
    <div class="eyebrow">404</div>
    <h1 style="font-size:52px;letter-spacing:-.03em;margin:12px 0 20px">This path doesn't lead anywhere.</h1>
    <p style="font-size:18px;color:#666;max-width:520px;margin:0 auto 30px">
      The page you were looking for isn't here — it may have moved, or never existed.
    </p>
    <p>
      <a class="back-link" href="/">← Back to the notebook</a>
      &nbsp;·&nbsp;
      <a class="back-link" href="/writings/">All writings</a>
    </p>
  </section>
</Base>
